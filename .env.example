OPENAI_API_KEY=sk-...

# Any OpenAI-compatible endpoint: the official API, a self-hosted gateway,
# vLLM, or a regional provider. Leave as-is for api.openai.com.
OPENAI_BASE_URL=https://api.openai.com/v1

VISION_MODEL=gpt-4o
ASR_MODEL=whisper-1

# Language of the generated prose (summary, scene descriptions).
# "source" keeps the video's own language; or set a code like "en" to normalise.
OUTPUT_LANGUAGE=source

# Frame selection — the cost lever.
SCENE_THRESHOLD=0.30
FRAME_HEIGHT=720
MAX_FRAMES=15
DHASH_DISTANCE=6

# GPU decode where available: cuda (NVDEC) | videotoolbox (macOS) | empty
HWACCEL=

AUDIO_BITRATE=32k
MAX_RETRIES=3
